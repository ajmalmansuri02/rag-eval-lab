# Copy to .env and adjust. Everything here is optional; defaults target a local Ollama.

# Where Ollama is listening.
OLLAMA_BASE_URL=http://localhost:11434

# Override the provider for every component in a config: ollama | gemini | offline
# (offline = hashing embedder + heuristic "LLM", no network, useful for smoke tests)
# RAG_LAB_PROVIDER=ollama

# Optional: Gemini (Google AI Studio free tier). Only needed for configs that use provider: gemini.
# Get a key at https://aistudio.google.com/ . Free-tier model names and quotas change over time;
# check the AI Studio docs and set the models explicitly below.
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_EMBED_MODEL=
# Throttle to stay under free-tier rate limits.
# GEMINI_REQUESTS_PER_MINUTE=10
